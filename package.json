{
  "name": "agentlane",
  "version": "0.6.2-rc.1",
  "description": "Run several AI coding agents on one machine, each with its own ports, dev servers, database and simulator, emulator or browser. Works with Claude Code, Codex, Cursor, GitHub Copilot, Gemini CLI and Antigravity, on web, iOS and Android.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "parallel-agents",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "github-copilot",
    "gemini-cli",
    "antigravity",
    "ios-simulator",
    "android-emulator",
    "playwright",
    "maestro",
    "worktrees",
    "dev-server",
    "port-conflicts",
    "dev-environment"
  ],
  "homepage": "https://north-star-hq.github.io/agentlane/",
  "bugs": "https://github.com/north-star-hq/agentlane/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/north-star-hq/agentlane.git"
  },
  "license": "MIT",
  "author": "North Star",
  "type": "module",
  "bin": {
    "agentlane": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "skills",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "lint:sh": "git ls-files -z '*.sh' | xargs -0 -r shellcheck",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./tests/support/isolate.ts --test 'tests/**/*.test.ts'",
    "schema": "node src/cli.ts schema > schema/agentlane.schema.json",
    "hero": "node scripts/hero/generate.ts",
    "site": "node site/build/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "marked": "18.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "yaml": "2.9.1"
  }
}
