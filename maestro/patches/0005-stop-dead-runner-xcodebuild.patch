@@ -0,0 +1,104 @@
+package xcuitest.installer
+
+import com.google.common.truth.Truth.assertThat
+import com.sun.net.httpserver.HttpServer
+import device.IOSDevice
+import io.mockk.every
+import io.mockk.mockk
+import maestro.utils.TempFileHandler
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import org.junit.jupiter.api.io.TempDir
+import util.IOSDeviceType
+import util.XCRunnerCLIUtils
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.ServerSocket
+import java.nio.file.Path
+import java.util.Collections
+
+class LocalXCTestInstallerTest {
+
+    @TempDir
+    lateinit var logsDir: Path
+
+    private val tempFileHandler = TempFileHandler()
+    private val deviceController = mockk<IOSDevice>(relaxed = true)
+    private val xcodebuilds = Collections.synchronizedList(mutableListOf<Process>())
+    private var server: HttpServer? = null
+
+    @AfterEach
+    fun tearDown() {
+        server?.stop(0)
+        xcodebuilds.forEach { it.destroyForcibly() }
+        tempFileHandler.close()
+    }
+
+    private fun freePort(): Int = ServerSocket(0, 0, InetAddress.getLoopbackAddress()).use { it.localPort }
+
+    private fun runner(port: Int, status: Int, body: String) {
+        val http = HttpServer.create(InetSocketAddress(InetAddress.getLoopbackAddress(), port), 0)
+        http.createContext("/") { exchange ->
+            val bytes = body.toByteArray()
+            exchange.sendResponseHeaders(status, bytes.size.toLong())
+            exchange.responseBody.use { it.write(bytes) }
+        }
+        http.start()
+        server = http
+    }
+
+    /**
+     * Stands in for `xcodebuild test-without-building`: each launch starts a child process that runs
+     * until it is stopped, and runs [onLaunch] first. A strict mock, so the installer can't reach for
+     * the runner's pid or kill anything else without the test failing.
+     */
+    private fun xcodebuild(onLaunch: () -> Unit = {}): XCRunnerCLIUtils = mockk {
+        every { runXcTestWithoutBuild(any(), any(), any(), any(), any()) } answers {
+            onLaunch()
+            ProcessBuilder("sleep", "600").start().also { xcodebuilds += it }
+        }
+    }
+
+    private fun installer(port: Int, xcRunnerCLIUtils: XCRunnerCLIUtils, startupTimeoutMs: Long = 120_000) =
+        LocalXCTestInstaller(
+            deviceId = "00000000-0000-0000-0000-000000000000",
+            deviceType = IOSDeviceType.SIMULATOR,
+            defaultPort = port,
+            iOSDriverConfig = LocalXCTestInstaller.IOSDriverConfig(
+                prebuiltRunner = false,
+                sourceDirectory = "driver-iPhoneSimulator",
+                context = Context.CLI,
+                snapshotKeyHonorModalViews = null,
+            ),
+            deviceController = deviceController,
+            tempFileHandler = tempFileHandler,
+            logsDir = logsDir.toFile(),
+            xcRunnerCLIUtils = xcRunnerCLIUtils,
+            startupTimeoutMs = startupTimeoutMs,
+        )
+
+    @Test
+    fun `uninstall stops the xcodebuild it started even when the runner no longer answers`() {
+        val port = freePort()
+        val installer = installer(port, xcodebuild { runner(port, 200, """{"status":"ok"}""") })
+        installer.start()
+        val xcodebuild = xcodebuilds.single()
+
+        server?.stop(0)
+        val uninstalled = installer.uninstall()
+
+        assertThat(uninstalled).isFalse()
+        assertThat(xcodebuild.isAlive).isFalse()
+    }
+
+    @Test
+    fun `a runner that never comes up fails the start, and the xcodebuild launched for it is stopped`() {
+        val installer = installer(freePort(), xcodebuild(), startupTimeoutMs = 1_500)
+
+        assertThrows<LocalXCTestInstaller.IOSDriverTimeoutException> { installer.start() }
+
+        assertThat(xcodebuilds).hasSize(1)
+        assertThat(xcodebuilds.single().isAlive).isFalse()
+    }
+}
