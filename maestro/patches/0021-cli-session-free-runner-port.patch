     ): Maestro {
@@ -405,10 +406,11 @@ object MaestroSessionManager {
             else -> throw UnsupportedOperationException("Unsupported device type $deviceType for iOS platform")
         }
 
+        val xcTestPort = xcTestPort(driverHostPort)
         val xcTestInstaller = LocalXCTestInstaller(
             deviceId = deviceId,
             host = defaultXctestHost,
-            defaultPort = driverHostPort ?: defaultXcTestPort,
+            defaultPort = xcTestPort,
             reinstallDriver = reinstallDriver,
             deviceType = iOSDeviceType,
             iOSDriverConfig = iOSDriverConfig,
@@ -419,7 +421,7 @@ object MaestroSessionManager {
 
         val xcTestDriverClient = XCTestDriverClient(
             installer = xcTestInstaller,
-            client = XCTestClient(defaultXctestHost, driverHostPort ?: defaultXcTestPort),
+            client = XCTestClient(defaultXctestHost, xcTestPort),
             reinstallDriver = reinstallDriver,
         )
 
@@ -447,6 +449,12 @@ object MaestroSessionManager {
         )
     }
 
+    internal fun xcTestPort(driverHostPort: Int?): Int =
+        driverHostPort ?: ServerSocket().use {
+            it.bind(InetSocketAddress(defaultXctestHost, 0))
+            it.localPort
+        }
+
     private fun pickWebDevice(isStudio: Boolean, isHeadless: Boolean, screenSize: String?): Maestro {
         return Maestro.web(isStudio, isHeadless, screenSize)
     }
diff --git a/maestro-cli/src/test/kotlin/maestro/cli/session/MaestroSessionManagerTest.kt b/maestro-cli/src/test/kotlin/maestro/cli/session/MaestroSessionManagerTest.kt
new file mode 100644
index 0000000..db327ac
--- /dev/null
+++ b/maestro-cli/src/test/kotlin/maestro/cli/session/MaestroSessionManagerTest.kt
@@ -0,0 +1,28 @@
+package maestro.cli.session
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.jupiter.api.Test
+import java.net.InetSocketAddress
+import java.net.ServerSocket
+
+class MaestroSessionManagerTest {
+
+    @Test
+    fun `an iOS session without a driver host port takes a free port, not the 22087 every such session used to share`() {
+        ServerSocket().use { anotherRunner ->
+            anotherRunner.bind(InetSocketAddress("127.0.0.1", 0))
+
+            val port = MaestroSessionManager.xcTestPort(driverHostPort = null)
+
+            assertThat(port).isNotEqualTo(22087)
+            assertThat(port).isNotEqualTo(anotherRunner.localPort)
+            ServerSocket().use { it.bind(InetSocketAddress("127.0.0.1", port)) }
+        }
+    }
+
+    @Test
+    fun `an iOS session uses the driver host port its caller passed`() {
+        assertThat(MaestroSessionManager.xcTestPort(driverHostPort = 22087)).isEqualTo(22087)
+        assertThat(MaestroSessionManager.xcTestPort(driverHostPort = 40123)).isEqualTo(40123)
+    }
+}
