         "MAESTRO_SHARD_INDEX",
     )
 
-    fun Map<String, String>.withInjectedShellEnvVars(): Map<String, String> = this +
-        System.getenv()
+    fun Map<String, String>.withInjectedShellEnvVars(
+        shellEnv: Map<String, String> = System.getenv(),
+    ): Map<String, String> = this +
+        shellEnv
             .filterKeys {
                 it.startsWith("MAESTRO_") &&
                     this.containsKey(it).not() &&
