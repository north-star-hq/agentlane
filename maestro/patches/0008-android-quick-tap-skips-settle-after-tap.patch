  */
 class AndroidDriverWindowSettleTest {
@@ -29,6 +29,24 @@ class AndroidDriverWindowSettleTest {
         assertThat(elapsedMs).isLessThan(500)
     }
 
+    @Test
+    fun `a zero waitToSettleTimeoutMs without an app id skips the hierarchy comparison and asks the device nothing`() {
+        val driver = AndroidDriver(mockk<AndroidDeviceConnection>())
+
+        val settled = driver.waitForAppToSettle(null, null, 0)
+
+        assertThat(settled).isNull()
+    }
+
+    @Test
+    fun `without an app id a positive timeout still reads the hierarchy from the device`() {
+        val driver = AndroidDriver(mockk<AndroidDeviceConnection>())
+
+        val error = assertThrows<MockKException> { driver.waitForAppToSettle(null, null, 200) }
+
+        assertThat(error.message).contains("AndroidDeviceConnection")
+    }
+
     @Test
     fun `without a timeout the window settle loop still asks the device whether the window is updating`() {
         val driver = AndroidDriver(mockk<AndroidDeviceConnection>())
