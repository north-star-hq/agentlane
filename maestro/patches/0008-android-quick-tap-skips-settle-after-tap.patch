diff --git a/maestro-client/src/test/java/maestro/TapRetryTest.kt b/maestro-client/src/test/java/maestro/TapRetryTest.kt
new file mode 100644
index 0000000..518b2a5
--- /dev/null
+++ b/maestro-client/src/test/java/maestro/TapRetryTest.kt
@@ -0,0 +1,55 @@
+package maestro
+
+import com.google.common.truth.Truth.assertThat
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.verify
+import kotlinx.coroutines.runBlocking
+import maestro.device.Platform
+import org.junit.jupiter.api.Test
+
+/**
+ * [Maestro.tap] on a driver with [Capability.FAST_HIERARCHY] that skips the settle for a zero
+ * waitToSettleTimeoutMs by returning null, as AndroidDriver does.
+ */
+class TapRetryTest {
+
+    private val before = TreeNode(attributes = mutableMapOf("text" to "Off"))
+    private val after = TreeNode(attributes = mutableMapOf("text" to "On"))
+
+    private fun driver(screens: () -> TreeNode): Driver = mockk(relaxed = true) {
+        every { capabilities() } returns listOf(Capability.FAST_HIERARCHY)
+        every { deviceInfo() } returns DeviceInfo(Platform.ANDROID, 1080, 2400, 1080, 2400)
+        every { contentDescriptor(any()) } answers { screens() }
+        every { waitForAppToSettle(null, null, 0) } returns null
+    }
+
+    @Test
+    fun `retryTapIfNoChange with a zero settle timeout taps again when the first tap changed nothing`() {
+        val driver = driver { before }
+
+        runBlocking { Maestro(driver).tap(x = 540, y = 1200, retryIfNoChange = true, waitToSettleTimeoutMs = 0) }
+
+        verify(exactly = 2) { driver.tap(Point(540, 1200)) }
+    }
+
+    @Test
+    fun `retryTapIfNoChange with a zero settle timeout doesn't tap again after a tap that changed the screen`() {
+        val screens = ArrayDeque(listOf(before, after))
+        val driver = driver { screens.removeFirstOrNull() ?: after }
+
+        runBlocking { Maestro(driver).tap(x = 540, y = 1200, retryIfNoChange = true, waitToSettleTimeoutMs = 0) }
+
+        verify(exactly = 1) { driver.tap(Point(540, 1200)) }
+    }
+
+    @Test
+    fun `a zero settle timeout without retryTapIfNoChange taps once and reads no hierarchy after the tap`() {
+        val driver = driver { before }
+
+        runBlocking { Maestro(driver).tap(x = 540, y = 1200, retryIfNoChange = false, waitToSettleTimeoutMs = 0) }
+
+        verify(exactly = 1) { driver.tap(Point(540, 1200)) }
+        verify(exactly = 1) { driver.contentDescriptor(any()) }
+    }
+}
diff --git a/maestro-client/src/test/java/maestro/drivers/AndroidDriverWindowSettleTest.kt b/maestro-client/src/test/java/maestro/drivers/AndroidDriverWindowSettleTest.kt
