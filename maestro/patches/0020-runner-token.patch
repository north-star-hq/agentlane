+package maestro.cli.mcp
+
+import com.google.common.truth.Truth.assertThat
+import com.sun.net.httpserver.HttpServer
+import io.mockk.every
+import io.mockk.mockk
+import ios.LocalIOSDevice
+import ios.xctest.XCTestIOSDevice
+import maestro.Driver
+import maestro.drivers.IOSDriver
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import util.IOSDeviceType
+import util.XCRunnerCLIUtils
+import xcuitest.XCTestClient
+import xcuitest.XCTestDriverClient
+import xcuitest.installer.Context
+import xcuitest.installer.LocalXCTestInstaller
+import java.io.IOException
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.ServerSocket
+import java.nio.file.Path
+import java.util.Collections
+
+/**
+ * An MCP iOS session over the real driver stack (IOSDriver, LocalIOSDevice, XCTestIOSDevice,
+ * XCTestDriverClient, LocalXCTestInstaller). Only the device is missing: each launch of
+ * `xcodebuild test-without-building` starts a child process and an HTTP server on the session's
+ * port that serves every request, standing in for the runner.
+ */
+class McpSessionRunnerTakenTest {
+
+    @TempDir
+    lateinit var logsDir: Path
+
+    private val runners = Collections.synchronizedMap(mutableMapOf<Int, HttpServer>())
+    private val foreignRequests = Collections.synchronizedList(mutableListOf<String>())
+    private val xcodebuilds = Collections.synchronizedMap(mutableMapOf<Int, Process>())
+
+    @AfterEach
+    fun tearDown() {
+        runners.values.forEach { it.stop(0) }
+        xcodebuilds.values.forEach { it.destroyForcibly() }
+    }
+
+    private fun freePort(): Int = ServerSocket(0, 0, InetAddress.getLoopbackAddress()).use { it.localPort }
+
+    private fun serve(port: Int, status: Int, body: String, onRequest: (String) -> Unit = {}): HttpServer {
+        val http = HttpServer.create(InetSocketAddress(InetAddress.getLoopbackAddress(), port), 0)
+        http.createContext("/") { exchange ->
+            onRequest(exchange.requestURI.path)
+            val bytes = body.toByteArray()
+            exchange.sendResponseHeaders(status, bytes.size.toLong())
+            exchange.responseBody.use { it.write(bytes) }
+        }
+        http.start()
+        return http
+    }
+
+    private fun iosDriver(deviceId: String, port: Int): Driver {
+        val xcodebuild = mockk<XCRunnerCLIUtils> {
+            every { runXcTestWithoutBuild(any(), any(), any(), any(), any(), any()) } answers {
+                runners[port] = serve(port, 200, """{"status":"ok"}""")
+                ProcessBuilder("sleep", "600").start().also { xcodebuilds[port] = it }
+            }
+        }
+        val installer = LocalXCTestInstaller(
+            deviceId = deviceId,
+            deviceType = IOSDeviceType.SIMULATOR,
+            defaultPort = port,
+            iOSDriverConfig = LocalXCTestInstaller.IOSDriverConfig(
+                prebuiltRunner = false,
+                sourceDirectory = "driver-iPhoneSimulator",
+                context = Context.CLI,
+                snapshotKeyHonorModalViews = null,
+            ),
+            deviceController = mockk(relaxed = true),
+            logsDir = logsDir.toFile(),
+            xcRunnerCLIUtils = xcodebuild,
+            fixedRunnerToken = null,
+        )
+        val client = XCTestDriverClient(installer, XCTestClient("127.0.0.1", port, token = null))
+        return IOSDriver(
+            LocalIOSDevice(
+                deviceId = deviceId,
+                xcTestDevice = XCTestIOSDevice(deviceId, client, getInstalledApps = { emptySet() }),
+                deviceController = mockk(relaxed = true),
+            )
+        )
+    }
+
+    @Test
+    fun `a session whose port another Maestro's runner took is rebuilt on a new port, and that runner is left alone`() {
+        val ports = ArrayDeque(listOf(freePort(), freePort()))
+        lateinit var manager: McpMaestroSessionManager
+        manager = McpMaestroSessionManager(
+            findFreePort = { ports.removeFirst() },
+            sessionFactory = { deviceId -> manager.startIosSession(deviceId, streamDeviceType = null) { port -> iosDriver(deviceId, port) } },
+        )
+        try {
+            val first = manager.withSession("SIM") { it }
+            val firstPort = first.xcTestPort!!
+            runners.remove(firstPort)!!.stop(0)
+            val foreign = serve(firstPort, 401, """{"code":"unauthorized","errorMessage":"wrong runner token"}""") {
+                foreignRequests += it
+            }
+
+            val rebuiltPort = try {
+                manager.withSession("SIM") { session ->
+                    if (session === first) throw IOException("the runner refused the request")
+                    session.xcTestPort
+                }
+            } finally {
+                foreign.stop(0)
+            }
+
+            assertThat(rebuiltPort).isNotEqualTo(firstPort)
+            assertThat(manager.isXCTestPortReserved(firstPort)).isFalse()
+            assertThat(xcodebuilds.getValue(firstPort).isAlive).isFalse()
+            assertThat(xcodebuilds.getValue(rebuiltPort!!).isAlive).isTrue()
+            assertThat(foreignRequests.toSet()).containsExactly("/status")
+
+            manager.close()
+            assertThat(xcodebuilds.getValue(rebuiltPort).isAlive).isFalse()
+        } finally {
+            manager.close()
+        }
+    }
+}
