@@ -0,0 +1,44 @@
+import XCTest
+@testable import MaestroDriverLib
+
+final class RunnerTokenTests: XCTestCase {
+
+    private let token = RunnerToken(environment: [RunnerToken.environmentVariable: "4f1c0d9e8b7a6f5e4d3c2b1a09f8e7d6"])
+
+    func testMatchingTokenIsServed() {
+        XCTAssertNil(token.refusal(presented: "4f1c0d9e8b7a6f5e4d3c2b1a09f8e7d6"))
+    }
+
+    func testMissingHeaderIsRefused() {
+        XCTAssertEqual(token.refusal(presented: nil), "missing X-Maestro-Runner-Token header")
+    }
+
+    func testWrongTokenIsRefused() {
+        XCTAssertEqual(token.refusal(presented: "4f1c0d9e8b7a6f5e4d3c2b1a09f8e7d7"), "wrong runner token")
+    }
+
+    func testPrefixOfTheTokenIsRefused() {
+        XCTAssertEqual(token.refusal(presented: "4f1c0d9e8b7a6f5e"), "wrong runner token")
+    }
+
+    func testEmptyPresentedTokenIsRefused() {
+        XCTAssertEqual(token.refusal(presented: ""), "wrong runner token")
+    }
+
+    func testRunnerWithoutTokenRefusesEveryRequest() {
+        let reason = "this runner was started without MAESTRO_RUNNER_TOKEN, so it refuses every request"
+        for environment in [[:], [RunnerToken.environmentVariable: ""]] {
+            let tokenless = RunnerToken(environment: environment)
+            XCTAssertEqual(tokenless.refusal(presented: nil), reason)
+            XCTAssertEqual(tokenless.refusal(presented: ""), reason)
+            XCTAssertEqual(tokenless.refusal(presented: "anything"), reason)
+        }
+    }
+
+    func testConstantTimeEquals() {
+        XCTAssertTrue(RunnerToken.constantTimeEquals(Array("abc".utf8), Array("abc".utf8)))
+        XCTAssertFalse(RunnerToken.constantTimeEquals(Array("abc".utf8), Array("abd".utf8)))
+        XCTAssertFalse(RunnerToken.constantTimeEquals(Array("abc".utf8), Array("abcd".utf8)))
+        XCTAssertFalse(RunnerToken.constantTimeEquals([], Array("a".utf8)))
+    }
+}
