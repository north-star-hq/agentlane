--- /dev/null
+++ b/maestro-ios-driver/src/main/kotlin/xcuitest/RunnerToken.kt
@@ -0,0 +1,47 @@
+package xcuitest
+
+import okhttp3.Interceptor
+import okhttp3.Request
+import java.security.SecureRandom
+
+/**
+ * The XCTest runner answers only requests that carry the token it was started with.
+ *
+ * If MAESTRO_RUNNER_TOKEN is set, every runner this process starts uses it; otherwise each runner
+ * launch gets a fresh random token, so a runner is bound to the process that started it.
+ */
+object RunnerToken {
+    const val HEADER = "X-Maestro-Runner-Token"
+    const val ENVIRONMENT_VARIABLE = "MAESTRO_RUNNER_TOKEN"
+
+    // xcodebuild passes TEST_RUNNER_<name> to the test runner as <name>, and simctl launch passes
+    // SIMCTL_CHILD_<name> to the launched app as <name>.
+    const val XCODEBUILD_VARIABLE = "TEST_RUNNER_$ENVIRONMENT_VARIABLE"
+    const val SIMCTL_VARIABLE = "SIMCTL_CHILD_$ENVIRONMENT_VARIABLE"
+
+    private const val RANDOM_BYTES = 32
+    private val VALID = Regex("[\\x21-\\x7E]+")
+    private val secureRandom = SecureRandom()
+
+    fun fromEnvironment(environment: Map<String, String> = System.getenv()): String? {
+        val token = environment[ENVIRONMENT_VARIABLE]?.takeIf { it.isNotEmpty() } ?: return null
+        require(VALID.matches(token)) {
+            "$ENVIRONMENT_VARIABLE must be printable ASCII without spaces, because it is sent in the $HEADER header"
+        }
+        return token
+    }
+
+    fun random(): String {
+        val bytes = ByteArray(RANDOM_BYTES).also(secureRandom::nextBytes)
+        return bytes.joinToString("") { "%02x".format(it) }
+    }
+
+    fun authorize(request: Request, token: String?): Request =
+        if (token == null) request else request.newBuilder().header(HEADER, token).build()
+
+    fun interceptor(token: () -> String?): Interceptor =
+        Interceptor { chain -> chain.proceed(authorize(chain.request(), token())) }
+
+    fun redact(environment: Map<String, String>): Map<String, String> =
+        environment.mapValues { (name, value) -> if (name.endsWith(ENVIRONMENT_VARIABLE)) "<redacted>" else value }
+}
