@@ -0,0 +1,37 @@
+import Foundation
+
+/// The token a runner was started with. Maestro passes it in the test environment next to PORT and
+/// sends it in `header` on every request; the runner answers only requests that carry it.
+public struct RunnerToken: Sendable {
+    public static let header = "X-Maestro-Runner-Token"
+    public static let environmentVariable = "MAESTRO_RUNNER_TOKEN"
+
+    private let expected: [UInt8]?
+
+    public init(environment: [String: String]) {
+        expected = environment[Self.environmentVariable].flatMap { $0.isEmpty ? nil : Array($0.utf8) }
+    }
+
+    /// Why a request that presents `presented` is refused, or nil when the runner should serve it.
+    public func refusal(presented: String?) -> String? {
+        guard let expected else {
+            return "this runner was started without \(Self.environmentVariable), so it refuses every request"
+        }
+        guard let presented else {
+            return "missing \(Self.header) header"
+        }
+        guard Self.constantTimeEquals(Array(presented.utf8), expected) else {
+            return "wrong runner token"
+        }
+        return nil
+    }
+
+    static func constantTimeEquals(_ lhs: [UInt8], _ rhs: [UInt8]) -> Bool {
+        guard lhs.count == rhs.count else { return false }
+        var difference: UInt8 = 0
+        for index in lhs.indices {
+            difference |= lhs[index] ^ rhs[index]
+        }
+        return difference == 0
+    }
+}
