+++ b/maestro-ios-driver/src/test/kotlin/xcuitest/RunnerTokenTest.kt
@@ -0,0 +1,64 @@
+package xcuitest
+
+import com.google.common.truth.Truth.assertThat
+import okhttp3.Request
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+
+class RunnerTokenTest {
+
+    @Test
+    fun `the token from MAESTRO_RUNNER_TOKEN is used when it is set`() {
+        val environment = mapOf("MAESTRO_RUNNER_TOKEN" to "claim-7f3a9c1e5b2d4f60")
+
+        assertThat(RunnerToken.fromEnvironment(environment)).isEqualTo("claim-7f3a9c1e5b2d4f60")
+    }
+
+    @Test
+    fun `no token comes from the environment when MAESTRO_RUNNER_TOKEN is unset or empty`() {
+        assertThat(RunnerToken.fromEnvironment(emptyMap())).isNull()
+        assertThat(RunnerToken.fromEnvironment(mapOf("MAESTRO_RUNNER_TOKEN" to ""))).isNull()
+    }
+
+    @Test
+    fun `a token that can't travel in an HTTP header is rejected`() {
+        for (bad in listOf("has space", "line\nbreak", "tab\there", "naïve")) {
+            assertThrows<IllegalArgumentException> {
+                RunnerToken.fromEnvironment(mapOf("MAESTRO_RUNNER_TOKEN" to bad))
+            }
+        }
+    }
+
+    @Test
+    fun `a random token carries 256 bits and differs on every launch`() {
+        val tokens = List(100) { RunnerToken.random() }
+
+        tokens.forEach { assertThat(it).matches("[0-9a-f]{64}") }
+        assertThat(tokens.toSet()).hasSize(100)
+    }
+
+    @Test
+    fun `authorize adds the token header, and leaves the request alone without a token`() {
+        val request = Request.Builder().url("http://127.0.0.1:1/status").build()
+
+        assertThat(RunnerToken.authorize(request, "abc123").header("X-Maestro-Runner-Token")).isEqualTo("abc123")
+        assertThat(RunnerToken.authorize(request, null).header("X-Maestro-Runner-Token")).isNull()
+    }
+
+    @Test
+    fun `redact hides the token in every launch environment and keeps the rest`() {
+        val redacted = RunnerToken.redact(
+            mapOf(
+                "TEST_RUNNER_PORT" to "61422",
+                "TEST_RUNNER_MAESTRO_RUNNER_TOKEN" to "secret",
+                "SIMCTL_CHILD_MAESTRO_RUNNER_TOKEN" to "secret",
+            )
+        )
+
+        assertThat(redacted).containsExactly(
+            "TEST_RUNNER_PORT", "61422",
+            "TEST_RUNNER_MAESTRO_RUNNER_TOKEN", "<redacted>",
+            "SIMCTL_CHILD_MAESTRO_RUNNER_TOKEN", "<redacted>",
+        )
+    }
+}
