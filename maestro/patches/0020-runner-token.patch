+    @Test
+    fun `every request to the runner carries the runner token`() {
+        val mockWebServer = MockWebServer()
+        val mapper = jacksonObjectMapper()
+        repeat(3) {
+            mockWebServer.enqueue(MockResponse().apply {
+                setResponseCode(200)
+                setBody(mapper.writeValueAsString(DeviceInfo(1, 2, 3, 4)))
+            })
+        }
+        mockWebServer.start(InetAddress.getByName("localhost"), 0)
+        val port = mockWebServer.port
+
+        val xcTestDriverClient = XCTestDriverClient(
+            installer = MockXCTestInstaller(MockXCTestInstaller.Simulator(), port = port),
+            client = XCTestClient("localhost", port, token = "claim-token"),
+        )
+        xcTestDriverClient.deviceInfo()
+        xcTestDriverClient.pressKey("home")
+        xcTestDriverClient.screenshot(compressed = true)
+
+        repeat(3) {
+            assertThat(mockWebServer.takeRequest().getHeader("X-Maestro-Runner-Token")).isEqualTo("claim-token")
+        }
+
+        mockWebServer.shutdown()
+    }
+
+    @Test
+    fun `after a restart the requests carry the restarted runner's token`() {
+        val mockWebServer = MockWebServer()
+        val mapper = jacksonObjectMapper()
+        repeat(2) {
+            mockWebServer.enqueue(MockResponse().apply {
+                setResponseCode(200)
+                setBody(mapper.writeValueAsString(DeviceInfo(1, 2, 3, 4)))
+            })
+        }
+        mockWebServer.start(InetAddress.getByName("localhost"), 0)
+        val port = mockWebServer.port
+        val restarted = object : XCTestInstaller {
+            override fun start() = XCTestClient("localhost", port, token = "second-launch")
+            override fun uninstall() = true
+            override fun isChannelAlive() = true
+            override fun close() = Unit
+        }
+
+        val xcTestDriverClient = XCTestDriverClient(
+            installer = restarted,
+            client = XCTestClient("localhost", port, token = "first-launch"),
+        )
+        xcTestDriverClient.deviceInfo()
+        xcTestDriverClient.restartXCTestRunner()
+        xcTestDriverClient.deviceInfo()
+
+        assertThat(mockWebServer.takeRequest().getHeader("X-Maestro-Runner-Token")).isEqualTo("first-launch")
+        assertThat(mockWebServer.takeRequest().getHeader("X-Maestro-Runner-Token")).isEqualTo("second-launch")
+
+        mockWebServer.shutdown()
+    }
+
